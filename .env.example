# Скопируйте в .env.local и заполните данными ТЕСТОВОГО проекта Supabase (регион Франкфурт).
# Ключи рабочей базы сюда не кладём.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Push-уведомления (необязательно: без них приложение работает, просто без уведомлений).
# Публичный ключ VAPID — виден в браузере.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# ДАЛЕЕ — ТОЛЬКО НА СЕРВЕРЕ (в Vercel тип Secret), никогда с префиксом NEXT_PUBLIC_:
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
# Сервисный ключ Supabase (service_role / secret) — обходит правила доступа, хранить как пароль.
SUPABASE_SERVICE_ROLE_KEY=
# Секрет для ежедневного напоминания (Vercel Cron передаёт его сам).
CRON_SECRET=
